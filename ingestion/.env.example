# EZAI ingestion — SERVER-SIDE ONLY. Copy to .env and fill per client.
# These are secrets (GHL token + Supabase service key) — never ship to a browser,
# never commit the real .env. Used only by backfill.js / sync-contacts.js / poll.ps1.

GHL_LOCATION_ID=<ghl-subaccount-location-id>
GHL_PIT=<ghl-private-integration-token>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
