# Porter dashboard — per-client config. Copy to .env and fill in per subaccount.
# Browser-safe values ONLY. The publishable/anon key is protected by Supabase
# RLS + Auth. NEVER put the Supabase service_role key or any GHL token here —
# those live only in the server-side ingestion (../ghl-call-export/.env).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_CLIENT_NAME=Client Full Name
VITE_CLIENT_SHORT=Client

# Optional: training AI roleplay link shown to users as "Start Training Call"
VITE_TRAINING_AI_URL=https://your-training-ai-link
